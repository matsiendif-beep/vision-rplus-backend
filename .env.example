# ============================================================
#  VISION R+ — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Base de données PostgreSQL ───────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/vision_rplus_dev"

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET="vision-rplus-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="vision-rplus-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Stripe (paiements) ───────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Stockage fichiers (S3 / Cloudflare R2) ───────────────────
STORAGE_ENDPOINT="https://..."
STORAGE_ACCESS_KEY="..."
STORAGE_SECRET_KEY="..."
STORAGE_BUCKET="vision-rplus"

# ── Claude AI (Anthropic) ────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Frontend URL (CORS) ───────────────────────────────────────
FRONTEND_URL="http://localhost:3001"
