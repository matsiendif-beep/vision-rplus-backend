# =============================================================
#  RAILWAY — Variables d'environnement à coller dans le dashboard
#  Settings > Variables dans votre projet Railway
# =============================================================

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# ── Supabase PostgreSQL ──────────────────────────────────────
# Supabase > Project Settings > Database > Connection string
# "Transaction" mode  (port 6543, via pgBouncer)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# "Session" mode ou connexion directe  (port 5432, pour prisma migrate)
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ── JWT ──────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET="REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_LONGUE"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="REMPLACER_PAR_UNE_AUTRE_VALEUR_ALEATOIRE"
JWT_REFRESH_EXPIRES_IN="30d"

# ── CORS — URL du frontend Vercel ────────────────────────────
# Mettre à jour après le déploiement Vercel
# Plusieurs origines possibles, séparées par une virgule
FRONTEND_URL="https://votre-projet.vercel.app,http://localhost:3001"
