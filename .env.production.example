# =============================================================
#  RAILWAY — Variables d'environnement à coller dans le dashboard
#  Settings > Variables dans votre projet Railway
# =============================================================

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# ── Supabase PostgreSQL ──────────────────────────────────────
# Supabase > Project Settings > Database > Connection string
# "Transaction" mode  (port 6543, via pgBouncer)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# "Session" mode ou connexion directe  (port 5432, pour prisma migrate)
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ── JWT ──────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET="REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_LONGUE"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="REMPLACER_PAR_UNE_AUTRE_VALEUR_ALEATOIRE"
JWT_REFRESH_EXPIRES_IN="30d"

# ── CORS — URL du frontend Vercel ────────────────────────────
# Mettre à jour après le déploiement Vercel
# Plusieurs origines possibles, séparées par une virgule
FRONTEND_URL="https://votre-projet.vercel.app,http://localhost:3001"

# ── Emails automatiques (Brevo) ───────────────────────────────
# Clé API : brevo.com > SMTP & API > Clés API. Sans clé, aucun email n'est envoyé.
BREVO_API_KEY=
# Expéditeur (le domaine doit être vérifié dans Brevo > Expéditeurs & domaines)
EMAIL_FROM=contact@visionrplus.com
EMAIL_FROM_NAME=Arnaud de Vision R+
EMAIL_REPLY_TO=contact@visionrplus.com
# URL du site (liens dans les emails)
APP_URL=https://www.visionrplus.com
# Lien de prise de rendez-vous (Calendly / Cal.com) pour l'email J+3 — optionnel
DEMO_BOOKING_URL=
# Mettre à true pour couper la séquence automatique (l'email de bienvenue reste envoyé)
EMAIL_SEQUENCE_DISABLED=false
